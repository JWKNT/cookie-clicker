import CookieClicker.JavaScriptExecution

/-! Physical input requests for the source/event kernel. This datatype has no
DOM target, callback, game-method name, event trust flag, RNG value or imported
save state. It is an explicit input boundary, not a native-input refinement.
Settings, Export and ordinary resets must run through the real UI handlers and
default actions generated by these inputs. Policy information restrictions and
seed-independent timing are separate requirements on a decision rule. -/
namespace CookieClicker.JavaScript.ExternalInput

/-- A finite native Number payload. No coordinate is a supplied hit-test result. -/
structure Scalar where
  bits : UInt64
  finite : Number.isFinite bits=true
  deriving Repr

structure Point where
  clientX : Scalar
  clientY : Scalar
  deriving Repr

inductive MouseButton where
  | primary | auxiliary | secondary | back | forward
  deriving Repr, DecidableEq

inductive WheelMode where
  | pixel | line | page
  deriving Repr, DecidableEq

/-- A physical key identity is interpreted by a fixed platform/layout model.
DOM key, code, keyCode, modifiers, repeat and composition flags are derived by
that model; the controller cannot independently forge those event fields. -/
structure PhysicalKey where
  usagePage : UInt16
  usage : UInt16
  deriving Repr, DecidableEq

inductive TextSource where
  | textService | publicPaste
  deriving Repr, DecidableEq

structure ViewportSize where
  width : Nat
  height : Nat
  widthPositive : 0<width
  heightPositive : 0<height
  deriving Repr

/-- Requests to the selected browser surface. Native platform validation and
reachability are not established by inhabiting this data type. -/
inductive Input where
  | mouseMove (point : Point)
  | mouseDown (button : MouseButton)
  | mouseUp (button : MouseButton)
  | wheel (deltaX deltaY : Scalar) (mode : WheelMode)
  | keyDown (key : PhysicalKey)
  | keyUp (key : PhysicalKey)
  | textCommit (source : TextSource) (text : JSString)
  | touchStart (contact : Nat) (point : Point)
  | touchMove (contact : Nat) (point : Point)
  | touchEnd (contact : Nat)
  | touchCancel (contact : Nat)
  | focusWindow
  | blurWindow
  | resizeViewport (size : ViewportSize)
  deriving Repr

/-- All event families from one raw native input must be accounted for. This
includes browser-generated events not named in the game source. -/
inductive Requirement where
  | pointerHitTestingAndHover
  | pointerStateCaptureAndActivation
  | scrollDefaultAction
  | keyboardLayoutFocusAndDefaults
  | textEditingClipboardAndComposition
  | touchTargetingAndCompatibilityMouse
  | windowFocusEventOrdering
  | viewportLayoutAndRendering
  deriving Repr, DecidableEq

def requirement : Input → Requirement
  | .mouseMove _ => .pointerHitTestingAndHover
  | .mouseDown _ | .mouseUp _ => .pointerStateCaptureAndActivation
  | .wheel _ _ _ => .scrollDefaultAction
  | .keyDown _ | .keyUp _ => .keyboardLayoutFocusAndDefaults
  | .textCommit _ _ => .textEditingClipboardAndComposition
  | .touchStart _ _ | .touchMove _ _ | .touchEnd _ | .touchCancel _ => .touchTargetingAndCompatibilityMouse
  | .focusWindow | .blurWindow => .windowFocusEventOrdering
  | .resizeViewport _ => .viewportLayoutAndRendering

def Requirement.request : Requirement → UnresolvedRequest
  | .pointerHitTestingAndHover => .unsupportedSyntax "Native pointer target, hover path, coordinate transform and pointer/mouse event sequence"
  | .pointerStateCaptureAndActivation => .unsupportedSyntax "Native held-button state, capture, target, click detail, focus/default activation and event sequence"
  | .scrollDefaultAction => .unsupportedSyntax "Native wheel/legacy-wheel events, passive cancellation and scroll default action"
  | .keyboardLayoutFocusAndDefaults => .unsupportedSyntax "Native keyboard layout, held keys, focused target, repeat, text and key default actions"
  | .textEditingClipboardAndComposition => .unsupportedSyntax "Native public text input/paste, composition, beforeinput/input and editing selection"
  | .touchTargetingAndCompatibilityMouse => .unsupportedSyntax "Native touch contacts, target capture, cancellation and compatibility pointer/mouse events"
  | .windowFocusEventOrdering => .unsupportedSyntax "Native page focus/blur, active element and ordered focus event procedure"
  | .viewportLayoutAndRendering => .unsupportedSyntax "Native viewport size validation, resize/layout, rendering and event procedure"

/-- A missing native operation stays missing. In particular, it is not replaced
by synthetic dispatchEvent, a direct Game call, a no-op or an illegal-action
verdict. The caller must retain the original browser state on this error. -/
def inject (state : Browser.State) (input : Input) : Checked Browser.State :=
  if Execution.atBoundary state then
    .error (.unresolved (requirement input).request)
  else .error (.fault (.invalidContinuation "Player input requested before the source/event procedure returned"))

/-- Reload is deliberately not a controller-selected Input constructor. A
future scheduler must first commit its clock-only schedule, then run current
native WriteSave, realm replacement and LoadSave with all effects retained. -/
def maintenance (state : Browser.State) : Checked Browser.State :=
  if Execution.atBoundary state then
    .error (.unresolved (.unsupportedSyntax "Committed clock-only current-save maintenance navigation and native save/load effects"))
  else .error (.fault (.invalidContinuation "Maintenance requested before the source/event procedure returned"))

theorem boundary_input_missing (state : Browser.State) (input : Input)
    (boundary : Execution.atBoundary state=true) :
    inject state input=.error (.unresolved (requirement input).request) := by simp [inject,boundary]

theorem unfinished_input_rejected (state : Browser.State) (input : Input)
    (boundary : Execution.atBoundary state=false) :
    inject state input=.error (.fault (.invalidContinuation
      "Player input requested before the source/event procedure returned")) := by simp [inject,boundary]

theorem input_has_no_fabricated_success (state next : Browser.State) (input : Input) :
    inject state input≠.ok next := by simp [inject]; split <;> simp

theorem boundary_maintenance_missing (state : Browser.State)
    (boundary : Execution.atBoundary state=true) :
    maintenance state=.error (.unresolved (.unsupportedSyntax
      "Committed clock-only current-save maintenance navigation and native save/load effects")) := by
  simp [maintenance,boundary]

theorem maintenance_has_no_fabricated_success (state next : Browser.State) :
    maintenance state≠.ok next := by simp [maintenance]; split <;> simp

end CookieClicker.JavaScript.ExternalInput
