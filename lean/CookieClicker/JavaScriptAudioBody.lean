def state (base : Machine) (frame : AudioMuted.Frame) (scopes : HasEnvironment.Scopes frame.window)
    (url vol pitch arguments : Value) : Machine := {
  ambient base frame scopes url vol pitch arguments .undefined .undefined with
  control:=.statement AudioSyntax.PlaySoundBody }

def completed (base : Machine) (frame : AudioMuted.Frame) (scopes : HasEnvironment.Scopes frame.window)
    (url vol pitch arguments volume : Value) : Machine := {
  ambient base frame scopes url vol pitch arguments volume (.number 0) with
  control:=.completion (.return (.number 0)) }

